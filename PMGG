local function clearPath(part)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local dir  = (part.Position - hrp.Position)
    local dist = dir.Magnitude
    if dist <= 0 then return true end
    dir = dir.Unit
    local ignore = {player.Character}
    local mobs   = Workspace:FindFirstChild("Mobs")
    if mobs then for _, m in ipairs(mobs:GetChildren()) do table.insert(ignore, m) end end
    local step = 2
    local pos  = hrp.Position
    for _ = 1, math.floor(dist / step) do
        local nextPos = pos + dir * step
        local hit = Workspace:FindPartOnRayWithIgnoreList(Ray.new(pos, nextPos - pos), ignore)
        if hit and hit.CanCollide then return false end
        pos = nextPos
    end
    return true
end

local function getClosestAssistMob()
    local hrp  = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local mobs = Workspace:FindFirstChild("Mobs")
    if not hrp or not mobs then return nil end
    local best, bestDist = nil, FastShootDistance
    for _, c in ipairs(mobs:GetDescendants()) do
        if c.Name == "HumanoidRootPart" then
            local model = c.Parent
            local hum   = model and model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not table.find(friendlyMobs, model.Name) then
                local d = (c.Position - hrp.Position).Magnitude
                if d <= FastShootDistance and d < bestDist and clearPath(c) then
                    bestDist = d; best = c
                end
            end
        end
    end
    return best
end

