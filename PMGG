local HitboxEnabled  = false
local HitboxSize     = 50
local HitboxRange    = 300
local mobsFolder     = workspace:WaitForChild("Mobs")
local originalSizes  = {}
local smartMobs      = { Froglo = true, Urchin = true }
local excludedMobs   = { Granny = true }

local function getHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function restoreAll()
    for part, size in pairs(originalSizes) do
        if part and part.Parent then part.Size = size end
    end
    table.clear(originalSizes)
end

task.spawn(function()
    while true do
        local char = player.Character
        local hrp  = getHRP(char)
        if HitboxEnabled and hrp then
            for _, obj in pairs(mobsFolder:GetDescendants()) do
                if obj.Name == "HumanoidRootPart" then
                    local mob = obj.Parent
                    if mob and excludedMobs[mob.Name] then
                        if originalSizes[obj] then obj.Size = originalSizes[obj]; originalSizes[obj] = nil end
                        continue
                    end
                    local humanoid = mob and mob:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        local dist = (obj.Position - hrp.Position).Magnitude
                        if dist <= HitboxRange and humanoid.Health > 0 then
                            if not originalSizes[obj] then originalSizes[obj] = obj.Size end
                            local newSize = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                            if mob and smartMobs[mob.Name] then
                                local mySize  = hrp.Size
                                local minDist = (newSize.Magnitude/2) + (mySize.Magnitude/2)
                                if dist < minDist then
                                    local safeSize = math.max(2, dist - mySize.Magnitude/2)
                                    obj.Size = Vector3.new(safeSize, safeSize, safeSize)
                                else
                                    obj.Size = newSize
                                end
                            else
                                obj.Size = newSize
                            end
                            obj.CanCollide = false
                        else
                            if originalSizes[obj] then obj.Size = originalSizes[obj]; originalSizes[obj] = nil end
                        end
                    end
                end
            end
        else
            if next(originalSizes) then restoreAll() end
        end
        task.wait(0.3)
    end
end)

