local prefixes = {
    "wonderful ","deft ","strong ","heavy ","light ",
    "swift ","sturdy ","fierce ","sharp ","mystic ",
    "ancient ","cursed ","blessed ","elite "
}
local function cleanName(name)
    if not name then return "" end
    name = name:lower()
    for _, p in pairs(prefixes) do name = name:gsub("^"..p, "") end
    return name
end
local function getMyMap(folder)
    local map = {}
    if not folder then return map end
    for _, v in pairs(folder:GetChildren()) do map[cleanName(v.Name)] = v.Name end
    return map
end
local function buildLoadout(target)
    if not target then return nil, {} end
    local myArmors      = getMyMap(lp:FindFirstChild("Armors"))
    local myHelmets     = getMyMap(lp:FindFirstChild("Helmets"))
    local myAccessories = getMyMap(lp:FindFirstChild("Accessories"))
    local missing = {}
    local function handleItem(typeName, value, myTable)
        if not value then return "" end
        local clean  = cleanName(value)
        local myItem = myTable[clean]
        if myItem then return myItem
        else table.insert(missing, typeName..": "..value); return "" end
    end
    local armorValue, helmetValue = "", ""
    local stats = target:FindFirstChild("CharacterStats")
    if stats then
        local armor  = stats:FindFirstChild("Armor")
        local helmet = stats:FindFirstChild("Helmet")
        armorValue  = handleItem("Armor",  armor  and armor.Value,  myArmors)
        helmetValue = handleItem("Helmet", helmet and helmet.Value, myHelmets)
    end
    local accessories = {}
    local accFolder   = target:FindFirstChild("EquippedAccessories")
    if accFolder then
        for i = 1, 5 do
            local acc = accFolder:FindFirstChild(tostring(i))
            if acc then
                local myItem = handleItem("Accessory", acc.Value, myAccessories)
                if myItem ~= "" then table.insert(accessories, {myItem, "Deft"}) end
            end
        end
    end
    local skillTable  = {}
    local targetSkill = target:FindFirstChild("SkillTree")
    if targetSkill then
        for _, v in pairs(targetSkill:GetChildren()) do
            if v:IsA("IntValue") or v:IsA("NumberValue") then
                table.insert(skillTable, {v.Name, v.Value})
            end
        end
    end
    local techValue = ""
    if stats then
        local tech = stats:FindFirstChild("Technique")
        techValue  = tech and tech.Value or ""
    end
    return {
        [1] = {armorValue,  "Wonderful"},
        [2] = {helmetValue, "Wonderful"},
        [3] = accessories,
        [4] = skillTable,
